{
  "description": "eSoul usage rules: inject the routing rules at session start and keep subagents off the main model",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/session-rules.md\"" }] }],
    "PreToolUse": [{ "matcher": "Agent|Task", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-guard.mjs\"", "timeout": 10 }] }]
  }
}
