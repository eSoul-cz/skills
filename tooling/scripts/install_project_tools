#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH= cd "${SCRIPT_DIR}/../.." && pwd)
TOOLING_ROOT="${REPOSITORY_ROOT}/tooling"
INSTALLER_DIR="${TOOLING_ROOT}/install-project-tools"
VERSION_FILE="${TOOLING_ROOT}/project-tools/docs/.documentation-tools/VERSION"

usage() {
    echo "Usage: tooling/scripts/install_project_tools PROJECT_ROOT [--check|--upgrade] [--remote|--local]" >&2
    exit 2
}

if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
    usage
fi

project_argument=$1
shift
action=
profile=auto
for option do
    case "${option}" in
        --check|--upgrade)
            if [ -n "${action}" ]; then
                usage
            fi
            action=${option}
            ;;
        --remote|--local)
            if [ "${profile}" != "auto" ]; then
                usage
            fi
            profile=${option#--}
            ;;
        *)
            usage
            ;;
    esac
done

if [ ! -d "${project_argument}" ]; then
    echo "ERROR: Project root does not exist: ${project_argument}" >&2
    exit 1
fi
PROJECT_ROOT=$(CDPATH= cd "${project_argument}" && pwd -P)
if [ "${PROJECT_ROOT}" = "/" ]; then
    echo "ERROR: Refusing to install project tools into the filesystem root." >&2
    exit 1
fi
if [ ! -f "${VERSION_FILE}" ]; then
    echo "ERROR: Missing bundled documentation tool VERSION file." >&2
    exit 1
fi
if ! command -v docker >/dev/null 2>&1; then
    echo "ERROR: Docker is required to install documentation project tools." >&2
    exit 1
fi
if ! docker info >/dev/null 2>&1; then
    echo "ERROR: Docker is installed but the daemon is unavailable." >&2
    exit 1
fi

version=$(sed -n '1{s/[^A-Za-z0-9_.-]/-/g;p;}' "${VERSION_FILE}")
installer_image="esoul-documentation-installer:${version}"
project_mount_mode=rw
if [ "${action}" = "--check" ]; then
    project_mount_mode=ro
fi

docker build \
    --file "${INSTALLER_DIR}/Dockerfile" \
    --tag "${installer_image}" \
    "${REPOSITORY_ROOT}"

set -- docker run \
    --rm \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --pids-limit 64 \
    --network none \
    --user "$(id -u):$(id -g)" \
    --volume "${TOOLING_ROOT}:/tooling:ro" \
    --volume "${PROJECT_ROOT}:/project:${project_mount_mode}" \
    "${installer_image}" \
    --asset-root /tooling/project-tools \
    --profile "${profile}"
if [ -n "${action}" ]; then
    set -- "$@" "${action}"
fi
set -- "$@" /project
exec "$@"
