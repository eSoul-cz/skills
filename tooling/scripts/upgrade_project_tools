#!/bin/sh
set -eu

# This trusted development wrapper delegates to the same GitHub-backed
# bootstrap used by end users. Git tags and their release.env assets are the
# only release index; no repository-local catalog is consulted.
SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH= cd "${SCRIPT_DIR}/../.." && pwd)
BOOTSTRAP="${REPOSITORY_ROOT}/install.sh"

usage() {
    echo "Usage: tooling/scripts/upgrade_project_tools PROJECT_ROOT [--to VERSION] [--apply]" >&2
    exit 2
}

[ "$#" -ge 1 ] && [ "$#" -le 4 ] || usage
project_argument=$1
shift
target_version=
apply=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --to)
            [ -z "${target_version}" ] && [ "$#" -ge 2 ] || usage
            target_version=$2
            shift 2
            ;;
        --apply)
            [ "${apply}" -eq 0 ] || usage
            apply=1
            shift
            ;;
        *)
            usage
            ;;
    esac
done

if [ -n "${target_version}" ] &&
    ! printf '%s\n' "${target_version}" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'
then
    echo "ERROR: Target documentation tooling version is not semantic: ${target_version}" >&2
    exit 1
fi

set -- "${BOOTSTRAP}" "${project_argument}" --upgrade
if [ "${apply}" -eq 1 ]; then
    set -- "$@" --apply
fi
DOCUMENTATION_TOOLS_VERSION="${target_version}" exec "$@"
