#!/bin/sh
# Runs every Node test of the repository: the skill checks (frontmatter, links, layers.json, the sources of
# every layer resolving through `npx skills add --list`, generated role briefs) and the tests of the skill
# scripts and of the @esoul-cz/skills helper. The source check needs git and the network.
set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH= cd "${SCRIPT_DIR}/../.." && pwd)
# The full image: `skills add --list` clones with git, which the alpine and slim images lack.
NODE_IMAGE='node:22'

cd "${REPOSITORY_ROOT}"

TESTS=$(find skills tooling/scripts -type f \( -name '*.test.mjs' -o -name 'test_*.mjs' \) -not -path '*/node_modules/*' | sort | tr '\n' ' ')

if command -v node >/dev/null 2>&1 && command -v git >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    exec node --test ${TESTS}
fi

if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
    echo 'test_skills needs Node.js with git, or a running Docker daemon.' >&2
    exit 1
fi

# Stream the files into the container instead of bind-mounting them, so the check also works
# when the Docker daemon runs on another host than this workspace.
tar --exclude=.git --exclude=node_modules -cf - . |
    docker run --rm -i "${NODE_IMAGE}" sh -c \
        "mkdir /work && cd /work && tar -xf - && node --test ${TESTS}"
