#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH= cd "${SCRIPT_DIR}/../.." && pwd)
CATALOG_TOOL="${REPOSITORY_ROOT}/tooling/project-tools/docs/.documentation-tools/release-catalog"
catalog_dir=$(mktemp -d "${TMPDIR:-/tmp}/documentation-release-catalog.XXXXXX")

cleanup() {
    case "${catalog_dir}" in
        "${TMPDIR:-/tmp}"/documentation-release-catalog.*)
            rm -rf "${catalog_dir}"
            ;;
    esac
}
trap cleanup EXIT HUP INT TERM

replace_value() {
    file=$1
    key=$2
    value=$3
    awk -F= -v key="${key}" -v value="${value}" '
        $1 == key {
            print key "=" value
            next
        }
        { print }
    ' "${file}" > "${file}.new"
    mv "${file}.new" "${file}"
}

cat > "${catalog_dir}/0.5.0.env" <<'EOF'
CATALOG_SCHEMA_VERSION=1
RENDERER_VERSION=0.5.0
RENDERER_IMAGE=registry.example/renderer@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ARCHITECTURES=linux/amd64,linux/arm64
PUBLISHED_AT=unknown
SOURCE_COMMIT=unknown
CONFIG_SCHEMA_VERSION=1
RELEASE_STATUS=legacy
UPGRADE_NOTES=Imported legacy release.
SBOM=unavailable
SCAN=unavailable
PROVENANCE=unavailable
SIGNATURE=unavailable
EOF

cat > "${catalog_dir}/0.6.0.env" <<'EOF'
CATALOG_SCHEMA_VERSION=1
RENDERER_VERSION=0.6.0
RENDERER_IMAGE=registry.example/renderer@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
ARCHITECTURES=linux/amd64,linux/arm64
PUBLISHED_AT=2026-07-28T12:00:00Z
SOURCE_COMMIT=cccccccccccccccccccccccccccccccccccccccc
CONFIG_SCHEMA_VERSION=1
RELEASE_STATUS=active
UPGRADE_NOTES=Current release.
SBOM=https://example.invalid/releases/0.6.0/renderer.spdx.json
SCAN=https://example.invalid/releases/0.6.0/renderer.scan.json
PROVENANCE=https://example.invalid/releases/0.6.0/renderer.provenance.json
SIGNATURE=https://example.invalid/releases/0.6.0/renderer.image.sigstore.json
INSTALLER_IMAGE=registry.example/installer@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
EOF

printf '0.5.0\n' > "${catalog_dir}/LATEST"
if DOCUMENTATION_RELEASE_CATALOG_DIR="${catalog_dir}" "${CATALOG_TOOL}" validate >/dev/null 2>&1; then
    echo "ERROR: Release catalog accepted a stale LATEST value." >&2
    exit 1
fi

printf '0.6.0\n' > "${catalog_dir}/LATEST"
DOCUMENTATION_RELEASE_CATALOG_DIR="${catalog_dir}" "${CATALOG_TOOL}" validate >/dev/null

replace_value "${catalog_dir}/0.6.0.env" PUBLISHED_AT unknown
if DOCUMENTATION_RELEASE_CATALOG_DIR="${catalog_dir}" "${CATALOG_TOOL}" validate >/dev/null 2>&1; then
    echo "ERROR: Release catalog accepted unknown active-release provenance." >&2
    exit 1
fi
replace_value "${catalog_dir}/0.6.0.env" PUBLISHED_AT 2026-07-28T12:00:00Z

replace_value "${catalog_dir}/0.6.0.env" SBOM unavailable
if DOCUMENTATION_RELEASE_CATALOG_DIR="${catalog_dir}" "${CATALOG_TOOL}" validate >/dev/null 2>&1; then
    echo "ERROR: Release catalog accepted unavailable active-release supply-chain metadata." >&2
    exit 1
fi
if DOCUMENTATION_RELEASE_CATALOG_ALLOW_RENDERER_ONLY_CANDIDATE=1 \
    DOCUMENTATION_RELEASE_CATALOG_ALLOW_UNAVAILABLE_SUPPLY_CHAIN_CANDIDATE=1 \
    DOCUMENTATION_RELEASE_CATALOG_DIR="${catalog_dir}" \
        "${CATALOG_TOOL}" validate >/dev/null 2>&1
then
    echo "ERROR: Release catalog accepted unavailable metadata for a complete active release." >&2
    exit 1
fi
replace_value "${catalog_dir}/0.6.0.env" SBOM https://example.invalid/releases/0.6.0/renderer.spdx.json

for invalid_artifact_url in 'https://?' 'https://#'; do
    replace_value "${catalog_dir}/0.6.0.env" SBOM "${invalid_artifact_url}"
    if DOCUMENTATION_RELEASE_CATALOG_DIR="${catalog_dir}" "${CATALOG_TOOL}" validate >/dev/null 2>&1; then
        echo "ERROR: Release catalog accepted an artifact URL without a host: ${invalid_artifact_url}" >&2
        exit 1
    fi
done
replace_value "${catalog_dir}/0.6.0.env" SBOM https://example.invalid/releases/0.6.0/renderer.spdx.json

replace_value "${catalog_dir}/0.6.0.env" INSTALLER_IMAGE registry.example/installer:0.6.0
if DOCUMENTATION_RELEASE_CATALOG_DIR="${catalog_dir}" "${CATALOG_TOOL}" validate >/dev/null 2>&1; then
    echo "ERROR: Release catalog accepted a mutable installer image." >&2
    exit 1
fi
awk -F= '$1 != "INSTALLER_IMAGE" { print }' \
    "${catalog_dir}/0.6.0.env" > "${catalog_dir}/0.6.0.env.new"
mv "${catalog_dir}/0.6.0.env.new" "${catalog_dir}/0.6.0.env"
if DOCUMENTATION_RELEASE_CATALOG_DIR="${catalog_dir}" "${CATALOG_TOOL}" validate >/dev/null 2>&1; then
    echo "ERROR: Release catalog accepted an active release without an installer." >&2
    exit 1
fi
replace_value "${catalog_dir}/0.6.0.env" SBOM unavailable
DOCUMENTATION_RELEASE_CATALOG_ALLOW_RENDERER_ONLY_CANDIDATE=1 \
DOCUMENTATION_RELEASE_CATALOG_ALLOW_UNAVAILABLE_SUPPLY_CHAIN_CANDIDATE=1 \
DOCUMENTATION_RELEASE_CATALOG_DIR="${catalog_dir}" \
    "${CATALOG_TOOL}" validate >/dev/null

echo "Release catalog tests passed."
