#!/bin/sh
set -eu

cache_root=$(mktemp -d /tmp/documentation-raster-cache.XXXXXX)
trap 'rm -rf "${cache_root}"' EXIT

mkdir -p "${cache_root}/staging"
printf 'return {}\n' > "${cache_root}/heading-map.lua"
printf '![Raster cache fixture](source.png)\n' > "${cache_root}/input.md"

render_fixture() {
    DOCUMENTATION_PROJECT_ROOT="${cache_root}" \
    DOCUMENTATION_SOURCE_DIR="${cache_root}" \
    DOCUMENTATION_STAGING_DIR="${cache_root}/staging" \
    DOCUMENTATION_HEADING_MAP="${cache_root}/heading-map.lua" \
    DOCUMENTATION_INTERNAL_TOKEN=raster-cache-smoke \
    DOCUMENTATION_MERMAID_CONFIG=/opt/documentation-tools/mermaid-config.json \
        pandoc \
            --from=markdown \
            --to=json \
            --lua-filter=/opt/documentation-tools/filters/source.lua \
            "${cache_root}/input.md" \
            >/dev/null
}

assert_cached_image_count() {
    expected=$1
    set -- "${cache_root}"/staging/image-*.png
    if [ "$#" -ne "${expected}" ] || [ ! -f "$1" ]; then
        echo "ERROR: expected ${expected} cached raster image(s), found $#." >&2
        exit 1
    fi
}

convert -size 2x2 xc:red "${cache_root}/source.png"
render_fixture
assert_cached_image_count 1
set -- "${cache_root}"/staging/image-*.png
red_cache=$1
red_digest=$(sha256sum "${red_cache}" | awk '{print $1}')

render_fixture
assert_cached_image_count 1

convert -size 2x2 xc:blue "${cache_root}/source.png"
render_fixture
assert_cached_image_count 2
set -- "${cache_root}"/staging/image-*.png
if [ "$1" = "${red_cache}" ]; then
    changed_cache=$2
elif [ "$2" = "${red_cache}" ]; then
    changed_cache=$1
else
    echo "ERROR: original red raster cache entry is missing." >&2
    exit 1
fi
changed_digest=$(sha256sum "${changed_cache}" | awk '{print $1}')
if [ "${changed_digest}" = "${red_digest}" ]; then
    echo "ERROR: changed raster cache entry has the original digest." >&2
    exit 1
fi
