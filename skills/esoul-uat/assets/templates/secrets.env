# eSoul UAT access for one repository and environment.
# Location: ~/.config/esoul-uat/<repository>.<environment>.env, chmod 600.
# Never commit, paste into chat, or copy into issues.
UAT_BASE_URL=
UAT_BASIC_AUTH_USER=
UAT_BASIC_AUTH_PASSWORD=
UAT_ROLE_A_EMAIL=
UAT_ROLE_A_PASSWORD=
# One pair per role code from environment.md, for example role B:
UAT_ROLE_B_EMAIL=
UAT_ROLE_B_PASSWORD=
# TOTP secret per role code, only for accounts with 2FA:
UAT_TOTP_A=
UAT_MAIL_URL=
UAT_MAIL_USER=
UAT_MAIL_PASSWORD=
