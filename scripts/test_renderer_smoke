#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
SKILL_ROOT=$(CDPATH= cd "${SCRIPT_DIR}/.." && pwd)
TOOLS_ROOT="${SKILL_ROOT}/assets/project-tools/docs/.documentation-tools/pdf"
FIXTURE_ROOT="${TOOLS_ROOT}/testdata/smoke"
VERSION_FILE="${SKILL_ROOT}/assets/project-tools/docs/.documentation-tools/VERSION"

if ! command -v docker >/dev/null 2>&1; then
    echo "ERROR: Docker is required for the renderer smoke test." >&2
    exit 1
fi
if ! docker info >/dev/null 2>&1; then
    echo "ERROR: Docker is installed but the daemon is unavailable." >&2
    exit 1
fi

smoke_root=$(mktemp -d "${TMPDIR:-/tmp}/documentation-renderer-smoke.XXXXXX")
cleanup() {
    rm -rf "${smoke_root}"
}
trap cleanup EXIT HUP INT TERM

cp -R "${FIXTURE_ROOT}/." "${smoke_root}/"
mkdir -p \
    "${smoke_root}/docs/pdf" \
    "${smoke_root}/docs/.documentation-work"

version=$(sed -n '1{s/[^A-Za-z0-9_.-]/-/g;p;}' "${VERSION_FILE}")
renderer_image="esoul-documentation-tools:${version}-smoke"
platform=${DOCUMENTATION_TEST_PLATFORM:-linux/amd64}

docker build \
    --platform "${platform}" \
    --build-arg "DOC_UID=$(id -u)" \
    --build-arg "DOC_GID=$(id -g)" \
    --file "${TOOLS_ROOT}/Dockerfile" \
    --tag "${renderer_image}" \
    "${TOOLS_ROOT}"

docker run \
    --rm \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --pids-limit 512 \
    --shm-size 256m \
    --network none \
    --tmpfs /tmp:rw,nosuid,nodev,size=1g \
    --env HOME=/tmp \
    --env XDG_CACHE_HOME=/tmp/.cache \
    --env DOC_COMMIT=smoke-test \
    --env DOC_GENERATED_AT="2026-01-01 00:00 UTC" \
    --platform "${platform}" \
    --user "$(id -u):$(id -g)" \
    --volume "${smoke_root}:/workspace:ro" \
    --volume "${smoke_root}/docs/pdf:/workspace/docs/pdf:rw" \
    --volume "${smoke_root}/docs/.documentation-work:/workspace/docs/.documentation-work:rw" \
    "${renderer_image}" \
    --project-root /workspace \
    --config docs/documentation.toml

docker run \
    --rm \
    --read-only \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --network none \
    --platform "${platform}" \
    --volume "${smoke_root}:/workspace:ro" \
    --entrypoint /bin/sh \
    "${renderer_image}" \
    -eu -c '
        extracted=/workspace/docs/.documentation-work/review/smoke/extracted.txt
        pdf=/workspace/docs/pdf/smoke.pdf
        test -s "${extracted}"
        test -s "${pdf}"

        normalized=$(tr "\n" " " < "${extracted}" | tr -s " ")
        case "${normalized}" in
            *"Figure 1:"*"A request flows through the Go renderer and Pandoc to a PDF."*) ;;
            *) echo "ERROR: first Mermaid figure caption or number is missing." >&2; exit 1 ;;
        esac
        case "${normalized}" in
            *"Figure 2:"*"A Markdown table and Mermaid diagram are rendered on a landscape page."*) ;;
            *) echo "ERROR: second Mermaid figure caption or number is missing." >&2; exit 1 ;;
        esac

        image_rows=$(pdfimages -list "${pdf}" | sed -n "3,\$p")
        if test -n "${image_rows}"; then
            echo "ERROR: smoke PDF contains raster image objects." >&2
            printf "%s\n" "${image_rows}" >&2
            exit 1
        fi

        set -- /workspace/docs/.documentation-work/build/smoke/staging/diagram-*.pdf
        if test "$#" -ne 2 || ! test -f "$1" || ! test -f "$2"; then
            echo "ERROR: expected exactly two rendered Mermaid PDFs." >&2
            exit 1
        fi
        for diagram_pdf do
            diagram_images=$(pdfimages -list "${diagram_pdf}" | sed -n "3,\$p")
            if test -n "${diagram_images}"; then
                echo "ERROR: Mermaid PDF contains raster image objects: ${diagram_pdf}" >&2
                exit 1
            fi
        done
    '

echo "Renderer smoke test passed: numbered captions are present and Mermaid output is vector-only."
