#!/bin/sh
set -eu

verify_only=0
if [ "${1:-}" = "--verify-only" ]; then
    verify_only=1
else
    DOC_COMMIT=smoke-test \
    DOC_GENERATED_AT="2026-01-01 00:00 UTC" \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
        documentation-renderer \
            --project-root /workspace \
            --config docs/documentation.toml
    DOC_COMMIT=smoke-test \
    DOC_GENERATED_AT="2026-01-01 00:00 UTC" \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
        documentation-renderer \
            --project-root /workspace \
            --config docs/esoul-documentation.toml
    DOC_COMMIT=smoke-test \
    DOC_GENERATED_AT="2026-01-01 00:00 UTC" \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
        documentation-renderer \
            --project-root /workspace \
            --config docs/local-font-documentation.toml
fi

extracted=/workspace/docs/.documentation-work/review/smoke/extracted.txt
pdf=/workspace/docs/pdf/smoke.pdf
esoul_extracted=/workspace/docs/.documentation-work/review/esoul-smoke/extracted.txt
esoul_pdf=/workspace/docs/pdf/esoul-smoke.pdf
local_font_extracted=/workspace/docs/.documentation-work/review/local-font-smoke/extracted.txt
local_font_pdf=/workspace/docs/pdf/local-font-smoke.pdf
test -s "${extracted}"
test -s "${pdf}"
test -s "${esoul_extracted}"
test -s "${esoul_pdf}"
test -s "${local_font_extracted}"
test -s "${local_font_pdf}"

normalized=$(tr "\n" " " < "${extracted}" | tr -s " ")
case "${normalized}" in
    *"Figure 1:"*"A request flows through the Go renderer and Pandoc to a PDF."*) ;;
    *) echo "ERROR: first Mermaid figure caption or number is missing." >&2; exit 1 ;;
esac
case "${normalized}" in
    *"Figure 2:"*"A Markdown table and Mermaid diagram are rendered on a landscape page."*) ;;
    *) echo "ERROR: second Mermaid figure caption or number is missing." >&2; exit 1 ;;
esac
case "${normalized}" in
    *"external maintenance notes"*"docs/guide/external.md"*) ;;
    *) echo "ERROR: cross-document link notice is missing or mapped incorrectly." >&2; exit 1 ;;
esac
case "${normalized}" in
    *"missing release notes"*"docs/missing.md#draft"*) ;;
    *) echo "ERROR: invalid-link notice is missing or mapped incorrectly." >&2; exit 1 ;;
esac
case "${normalized}" in
    *"A multiline footnote keeps emphasis, inline code, a link, and Czech text: příliš žluťoučký kůň."*) ;;
    *) echo "ERROR: complex Markdown footnote content is missing." >&2; exit 1 ;;
esac

image_rows=$(pdfimages -list "${pdf}" | sed -n "3,\$p")
if [ -n "${image_rows}" ]; then
    echo "ERROR: smoke PDF contains raster image objects." >&2
    printf "%s\n" "${image_rows}" >&2
    exit 1
fi

set -- \
    /workspace/docs/.documentation-work/build/smoke/staging/diagram-*.pdf \
    /workspace/docs/.documentation-work/build/esoul-smoke/staging/diagram-*.pdf
if [ "$#" -ne 4 ] || [ ! -f "$1" ] || [ ! -f "$2" ] || [ ! -f "$3" ] || [ ! -f "$4" ]; then
    echo "ERROR: expected exactly two rendered Mermaid PDFs per theme fixture." >&2
    exit 1
fi
for diagram_pdf do
    diagram_images=$(pdfimages -list "${diagram_pdf}" | sed -n "3,\$p")
    if [ -n "${diagram_images}" ]; then
        echo "ERROR: Mermaid PDF contains raster image objects: ${diagram_pdf}" >&2
        exit 1
    fi
done

esoul_normalized=$(tr "\n" " " < "${esoul_extracted}" | tr -s " ")
case "${esoul_normalized}" in
    *"Client & Operations Guide"*) ;;
    *) echo "ERROR: eSoul title page is missing." >&2; exit 1 ;;
esac
case "${esoul_normalized}" in
    *"esoul.cz"*"info@esoul.cz"*) ;;
    *) echo "ERROR: eSoul publisher contact is missing." >&2; exit 1 ;;
esac
case "${esoul_normalized}" in
    *"IČ: 17582571"*"DIČ: CZ17582571"*) ;;
    *) echo "ERROR: eSoul publisher identity is missing." >&2; exit 1 ;;
esac
if ! pdffonts "${esoul_pdf}" | grep -q "Poppins"; then
    echo "ERROR: eSoul PDF does not embed Poppins." >&2
    exit 1
fi
if ! pdffonts "${esoul_pdf}" | grep -q "Syne"; then
    echo "ERROR: eSoul PDF does not embed Syne." >&2
    exit 1
fi
if ! pdffonts "${local_font_pdf}" | grep -q "DocumentationFixture"; then
    echo "ERROR: project-local font was not discovered and embedded." >&2
    exit 1
fi
esoul_image_rows=$(pdfimages -list "${esoul_pdf}" | sed -n "3,\$p")
if [ -n "${esoul_image_rows}" ]; then
    echo "ERROR: eSoul PDF contains raster image objects." >&2
    printf "%s\n" "${esoul_image_rows}" >&2
    exit 1
fi
local_font_image_rows=$(pdfimages -list "${local_font_pdf}" | sed -n "3,\$p")
if [ -n "${local_font_image_rows}" ]; then
    echo "ERROR: project-local font PDF contains raster image objects." >&2
    printf "%s\n" "${local_font_image_rows}" >&2
    exit 1
fi

if [ "${verify_only}" -eq 0 ]; then
    touch /tmp/documentation-renderer-smoke-passed
fi
