#!/bin/sh
set -eu

DOCS_DIR="$(CDPATH= cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(CDPATH= cd "${DOCS_DIR}/.." && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"

if ! command -v "${PYTHON_BIN}" >/dev/null 2>&1; then
    echo "ERROR: Python 3.11 or newer is required." >&2
    exit 1
fi

if ! "${PYTHON_BIN}" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
    echo "ERROR: Python 3.11 or newer is required." >&2
    exit 1
fi

if [ ! -f "${PROJECT_ROOT}/docs/documentation.toml" ] && [ "${1:-}" != "version" ]; then
    echo "ERROR: Missing docs/documentation.toml" >&2
    exit 1
fi

case "${1:-}" in
    build|render|redact)
        if ! command -v docker >/dev/null 2>&1; then
            echo "ERROR: Docker is required for '${1}'." >&2
            exit 1
        fi
        if ! docker info >/dev/null 2>&1; then
            echo "ERROR: Docker is installed but the daemon is unavailable." >&2
            exit 1
        fi
        ;;
esac

exec "${PYTHON_BIN}" "${DOCS_DIR}/.documentation-tools/docs.py" \
    --project-root "${PROJECT_ROOT}" "$@"
